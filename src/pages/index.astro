---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import USPLeiste from '../components/USPLeiste.astro';
import ServiciosPreview from '../components/ServiciosPreview.astro';
import AntesDespues from '../components/AntesDespues.astro';
import Testimoniales from '../components/Testimoniales.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
---
<Layout lang={lang}>
  <Header lang={lang} page="" />
  <main>
    <Hero lang={lang} />
    <USPLeiste lang={lang} />
    <ServiciosPreview lang={lang} />
    <AntesDespues lang={lang} />
    <Testimoniales lang={lang} />
    <Contacto lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
