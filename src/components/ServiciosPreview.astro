---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const langBase = lang === 'es' ? b : `${b}/${lang}`;

const homeIcon = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`;
const buildIcon = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`;
const sofaIcon = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 10V7a2 2 0 00-2-2H6a2 2 0 00-2 2v3M4 10a2 2 0 00-2 2v3a2 2 0 002 2h1v2h2v-2h10v2h2v-2h1a2 2 0 002-2v-3a2 2 0 00-2-2H4z"/></svg>`;
const glassIcon = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>`;

const items = {
  es: [
    { title: 'Limpieza doméstica', desc: 'Hogares, pisos y casas rurales. Servicio regular o puntual.', img: 'habitacion-limpia.jpeg', icon: homeIcon },
    { title: 'Fin de obra', desc: 'Limpieza especializada tras reformas y construcciones.', img: 'makita-finobra.jpeg', icon: buildIcon },
    { title: 'Tapicerías', desc: 'Sofás, sillones y moquetas con maquinaria Kärcher profesional.', img: 'tapiceria-sofa.jpeg', icon: sofaIcon },
    { title: 'Cristales', desc: 'Interiores y exteriores sin rayas ni residuos.', img: 'cristales-puerta.jpeg', icon: glassIcon },
  ],
  en: [
    { title: 'Domestic cleaning', desc: 'Homes, flats and rural houses. Regular or one-off service.', img: 'habitacion-limpia.jpeg', icon: homeIcon },
    { title: 'Post-construction', desc: 'Specialist cleaning after renovations and building work.', img: 'makita-finobra.jpeg', icon: buildIcon },
    { title: 'Upholstery', desc: 'Sofas, armchairs and carpets with professional Kärcher machinery.', img: 'tapiceria-sofa.jpeg', icon: sofaIcon },
    { title: 'Glass cleaning', desc: 'Interior and exterior glass, no streaks or residues.', img: 'cristales-puerta.jpeg', icon: glassIcon },
  ],
  de: [
    { title: 'Haushaltsreinigung', desc: 'Häuser, Wohnungen und Landhäuser. Regelmäßig oder einmalig.', img: 'habitacion-limpia.jpeg', icon: homeIcon },
    { title: 'Baureinigung', desc: 'Spezialisierte Reinigung nach Renovierungen und Bauprojekten.', img: 'makita-finobra.jpeg', icon: buildIcon },
    { title: 'Polsterreinigung', desc: 'Sofas, Sessel und Teppiche mit professioneller Kärcher-Maschine.', img: 'tapiceria-sofa.jpeg', icon: sofaIcon },
    { title: 'Glasreinigung', desc: 'Innen- und Außenverglasungen ohne Streifen oder Rückstände.', img: 'cristales-puerta.jpeg', icon: glassIcon },
  ],
};

const labels = {
  es: { badge: 'Nuestros servicios', heading: 'Lo que hacemos', more: 'Ver todos los servicios' },
  en: { badge: 'Our services', heading: 'What we do', more: 'See all services' },
  de: { badge: 'Unsere Dienste', heading: 'Was wir tun', more: 'Alle Dienste ansehen' },
};

const currentItems = items[lang];
const l = labels[lang];
---

<section class="py-20 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">{l.badge}</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900">{l.heading}</h2>
      </div>
      <a href={`${langBase}/servicios/`}
        class="flex items-center gap-2 text-eco-700 font-semibold text-sm hover:text-eco-900 transition-colors whitespace-nowrap">
        {l.more}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentItems.map(item => (
        <a href={`${langBase}/servicios/`}
          class="group block border border-gray-200 hover:border-eco-400 transition-colors duration-150 overflow-hidden">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={`${base}/images/${item.img}`}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-5">
            <div class="inline-flex w-8 h-8 items-center justify-center bg-eco-100 text-eco-700 mb-3 group-hover:bg-eco-700 group-hover:text-white transition-colors duration-150" set:html={item.icon} />
            <h3 class="font-bold text-gray-900 text-base mb-1 group-hover:text-eco-700 transition-colors">{item.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
